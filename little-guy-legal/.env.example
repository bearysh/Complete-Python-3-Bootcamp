# Little Guy Legal — local configuration. Copy to .env and edit. Never commit .env.
# Where case data lives (outside the repository). Default: ~/LittleGuyLegal/data
LGL_DATA_DIR=~/LittleGuyLegal/data
# Bind address for the web app. Milestone 1 is localhost-only.
LGL_HOST=127.0.0.1
LGL_PORT=8765
# Inference provider: hermes (primary) | omlx (diagnostic, direct) | scripted (TEST ONLY)
LGL_INFERENCE_PROVIDER=hermes
# Hermes API server (dedicated little-guy-legal profile). Loopback only.
LGL_HERMES_BASE_URL=http://127.0.0.1:8642
# API key for the Hermes API server. Set it here; never print it.
LGL_HERMES_API_KEY=
LGL_HERMES_MODEL=
# Direct OMLX endpoint (diagnostic path). Loopback only.
LGL_OMLX_BASE_URL=http://127.0.0.1:8000
LGL_OMLX_API_KEY=
LGL_OMLX_MODEL=
# Inference limits
LGL_REQUEST_TIMEOUT_SECONDS=900
LGL_MAX_RETRIES=2
LGL_MAX_OUTPUT_TOKENS=6000
LGL_MAX_EVIDENCE_CHARS=60000
# TEST ONLY: the scripted provider replays fixture outputs and performs no inference.
# Both flags must be set for it to be selectable. Never use for a real case.
# LGL_ALLOW_SCRIPTED_PROVIDER=1
# LGL_SCRIPTED_RESPONSES_DIR=fixtures/scripted_responses
