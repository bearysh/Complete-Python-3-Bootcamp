# Place at ~/.hermes/profiles/little-guy-legal/.env (mode 0600). Only these variables; nothing else.
# The API server refuses to start without a key of at least 16 characters.
API_SERVER_KEY=REPLACE_WITH_RANDOM_32_CHARS
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_MODEL_NAME=little-guy-legal
